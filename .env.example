# --- Providers ---------------------------------------------------------------
# Production: groq + tavily. Stubs ("stub") are for tests/CI/offline demos.
# Keys are NEVER stored here: GROQ_API_KEY / TAVILY_API_KEY are transient
# (process env only), otherwise the custom.groq / custom.tavily Secure Vault
# connectors supply a surrogate at runtime.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=        # set transiently in the environment, never in a file
LLM_BASE_URL=http://localhost:11434/v1   # only for LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b

SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=      # set transiently in the environment, never in a file

# --- State ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Budgets (per research run) ----------------------------------------------
MAX_TOKENS_PER_RUN=60000
MAX_SEARCHES_PER_RUN=12
MAX_SUBQUESTIONS_PER_RUN=5
MAX_REVISIONS_PER_RUN=2
WALL_CLOCK_TIMEOUT_SEC=600

# --- Cost model (USD per 1M tokens; used only for cost *estimates*) -----------
PRICE_INPUT_PER_1M_USD=0.15
PRICE_OUTPUT_PER_1M_USD=0.60

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
# Test-only hook: artificial delay (seconds) injected at the start of every
# graph node. Used by the kill-and-resume chaos test to widen the kill window.
STEP_DELAY_SEC=0
