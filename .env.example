# --- Providers ---------------------------------------------------------------
# llm: "stub" (deterministic, for tests/demos) or "openai_compat" (any
# OpenAI-compatible chat-completions endpoint, e.g. Ollama, vLLM, OpenAI)
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b

# search: "stub" (canned results, for tests/demos) or "tavily"
SEARCH_PROVIDER=stub
TAVILY_API_KEY=

# --- State ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Budgets (per research run) ----------------------------------------------
MAX_TOKENS_PER_RUN=60000
MAX_SEARCHES_PER_RUN=12
MAX_SUBQUESTIONS_PER_RUN=5
MAX_REVISIONS_PER_RUN=2
WALL_CLOCK_TIMEOUT_SEC=600

# --- Cost model (USD per 1M tokens; used only for cost *estimates*) -----------
PRICE_INPUT_PER_1M_USD=0.15
PRICE_OUTPUT_PER_1M_USD=0.60

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
# Test-only hook: artificial delay (seconds) injected at the start of every
# graph node. Used by the kill-and-resume chaos test to widen the kill window.
STEP_DELAY_SEC=0
